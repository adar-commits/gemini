{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HoM QA analyze output (Grok → Composer gate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "conversation_url",
    "trigger",
    "verdict",
    "confidence",
    "root_cause"
  ],
  "properties": {
    "session_id": { "type": "string" },
    "conversation_url": { "type": "string" },
    "trigger": {
      "enum": ["human_assign", "bot_failure", "reset", "closed_unanswered"]
    },
    "verdict": {
      "enum": [
        "false_alarm",
        "real_failure",
        "too_risky",
        "ask_operator",
        "already_covered"
      ]
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "root_cause": { "type": "string" },
    "fix_layer": {
      "enum": ["prompt", "hints", "tool_guard", "pre_turn", "runtime"]
    },
    "fix_plan": { "type": "array", "items": { "type": "string" } },
    "operator_questions": { "type": "array", "items": { "type": "string" } },
    "duplicate_of_commit": { "type": ["string", "null"] },
    "risk_notes": { "type": "string" },
    "analyzed_at": { "type": "string" }
  }
}
