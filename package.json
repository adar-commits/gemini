{
  "name": "gemini",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run test:gold && npm run test:contracts && npm run test:qa-guard && npm run guard:qa-fix:commit",
    "test:qa-guard": "npx tsx --test lib/hom-agent/__tests__/qa-fix-guard.test.ts lib/hom-agent/__tests__/qa-analysis.test.ts",
    "guard:qa-fix": "npx tsx scripts/guard-qa-fix-diff.ts",
    "guard:qa-fix:commit": "npx tsx scripts/guard-qa-fix-diff.ts --commit",
    "qa:vanish": "npx tsx scripts/vanish-qa-commit.ts",
    "qa:log": "npx tsx scripts/log-qa-run.ts",
    "qa:backfill": "npx tsx scripts/backfill-qa-runs.ts",
    "qa:chain-implement": "npx tsx scripts/chain-qa-implement-webhook.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:fixtures": "npx tsx --test lib/agents/__tests__/council-fixtures.test.ts lib/landbot/__tests__/allowlist.test.ts",
    "test:gold": "npx tsx --test lib/agents/__tests__/gold-conversations.test.ts",
    "test:contracts": "npx tsx --test lib/hom-agent/__tests__/contract-replay.test.ts lib/hom-agent/__tests__/legislator-collision-pairs.test.ts",
    "contracts:import": "npx tsx scripts/contracts-import.ts",
    "contracts:scan": "npx tsx scripts/run-violation-scanner.ts",
    "verify:deploy": "npm run build",
    "test:predeploy": "npm run test:gold && npm run test:contracts && npx tsx --test lib/hom-agent/__tests__/*.test.ts lib/agents/__tests__/*.test.ts lib/agent-core/__tests__/*.test.ts && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "ai": "^7.0.77",
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@n8n/workflow-sdk": "^0.12.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
